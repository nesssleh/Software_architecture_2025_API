digraph G {
graph [rankdir=LR, fontname="DejaVu Sans", fontsize=11, bgcolor=white, pad=0.3, nodesep=0.45, ranksep=0.7, labelloc=t];
node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=10, color="#2b4a7a", fillcolor="#dce7f7", margin="0.15,0.08"];
edge [fontname="DejaVu Sans", fontsize=8, color="#555555"];
label="C4 Level 1 — System Context: ReturnGuard";
analyst [shape=box, style="rounded,filled", fillcolor="#08427b", fontcolor=white, label="Аналитик антифрода\n[Person]"];
oms [fillcolor="#e8e8e8", color="#888888", label="OMS / интернет-магазин\n[External system]"];
carriers [fillcolor="#e8e8e8", color="#888888", label="Службы доставки\nСДЭК, Boxberry, Почта\n[External]"];
rg [fillcolor="#438dd5", fontcolor=white, label="ReturnGuard\n[Software system]\nскоринг возвратов,\nкейсы расследований"];
oms -> rg [label="заказы, возвраты\n(REST/события)"]; carriers -> rg [label="вебхуки статусов"]; rg -> oms [label="решение: approve/review/block"]; analyst -> rg [label="кейсы, решения\n(REST)"];
}