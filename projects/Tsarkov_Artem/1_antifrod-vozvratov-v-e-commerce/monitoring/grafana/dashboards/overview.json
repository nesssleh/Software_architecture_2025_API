  {
   "id": 20,
   "type": "timeseries",
   "title": "Решения по дням (return_scores)",
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "ch"
   },
   "gridPos": {
    "x": 0,
    "y": 44,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "ch"
     },
     "editorType": "sql",
     "format": 0,
     "queryType": "timeseries",
     "rawSql": "SELECT toStartOfDay(ts) AS time, countIf(decision='block') AS block, countIf(decision='review') AS review, countIf(decision='approve') AS approve FROM return_scores FINAL GROUP BY time ORDER BY time"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 21,
   "type": "barchart",
   "title": "Причины возвратов (разбор JSON-payload прямо в ClickHouse)",
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "ch"
   },
   "gridPos": {
    "x": 12,
    "y": 44,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "ch"
     },
     "editorType": "sql",
     "format": 1,
     "queryType": "table",
     "rawSql": "SELECT JSONExtractString(payload, 'reason') AS reason, count() AS returns FROM order_events WHERE type = 'return.requested' GROUP BY reason ORDER BY returns DESC"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
