   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "ch"
     },
     "editorType": "sql",
     "format": 1,
     "queryType": "table",
     "rawSql": "SELECT customer_id, count() AS returns, round(avg(score), 3) AS avg_score, round(sum(amount)) AS amount, countIf(decision='block') AS blocked FROM return_scores FINAL GROUP BY customer_id ORDER BY avg_score DESC, returns DESC LIMIT 15"
