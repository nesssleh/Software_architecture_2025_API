digraph G {
graph [rankdir=LR, fontname="DejaVu Sans", fontsize=11, bgcolor=white, pad=0.3, nodesep=0.45, ranksep=0.7, labelloc=t];
node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=10, color="#2b4a7a", fillcolor="#dce7f7", margin="0.15,0.08"];
edge [fontname="DejaVu Sans", fontsize=8, color="#555555"];
label="C4 Level 2 — Containers: GeoSeg";
u [shape=box, style="rounded,filled", fillcolor="#08427b", fontcolor=white, label="Клиент API"];
api [fillcolor="#438dd5", fontcolor=white, label="geoseg-api\n[FastAPI, Facade]"];
minio [shape=cylinder, fillcolor="#f5e6c8", color="#a07a2a", label="MinIO (S3)\nraw/, tiles/, masks/"];
t1 [shape=cds, fillcolor="#fde2d4", color="#c0582a", label="raster.ingested"];
tl [fillcolor="#438dd5", fontcolor=white, label="tiler\n[group tiler]"];
t2 [shape=cds, fillcolor="#fde2d4", color="#c0582a", label="tiles.ready\n(key=raster_id)"];
inf [fillcolor="#438dd5", fontcolor=white, label="inference-worker x3\n[U-Net, group\ninference-worker]"];
t3 [shape=cds, fillcolor="#fde2d4", color="#c0582a", label="tiles.segmented"];
gst [fillcolor="#438dd5", fontcolor=white, label="geostore\n[mosaic + vectorize]"];
pg [shape=cylinder, fillcolor="#f5e6c8", color="#a07a2a", label="PostgreSQL + PostGIS\nrasters, landcover\n(GIST)"];
t4 [shape=cds, fillcolor="#fde2d4", color="#c0582a", label="raster.completed"];
u -> api; api -> minio; api -> pg; api -> t1 [label="async"]; t1 -> tl; tl -> t2; t2 -> inf; inf -> minio [label="proba tiles"]; inf -> t3; t3 -> gst; gst -> minio; gst -> pg; gst -> t4;
}