digraph G {
graph [rankdir=LR, fontname="DejaVu Sans", fontsize=11, bgcolor=white, pad=0.3, nodesep=0.45, ranksep=0.7, labelloc=t];
node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=10, color="#2b4a7a", fillcolor="#dce7f7", margin="0.15,0.08"];
edge [fontname="DejaVu Sans", fontsize=8, color="#555555"];
label="C4 Level 1 — System Context: SkillMatch";
hr [shape=box, style="rounded,filled", fillcolor="#08427b", fontcolor=white, label="Рекрутер\n[Person]"];
cand [shape=box, style="rounded,filled", fillcolor="#08427b", fontcolor=white, label="Кандидат\n[Person]"];
ats [fillcolor="#e8e8e8", color="#888888", label="ATS / job-board\n[External]"];
llm [fillcolor="#e8e8e8", color="#888888", label="LLM-провайдер\n(Ollama / OpenAI-compatible)"];
sm [fillcolor="#438dd5", fontcolor=white, label="SkillMatch\n[Software system]"];
ats -> sm [label="резюме, вакансии"]; hr -> sm [label="подбор кандидатов"]; cand -> sm [label="разбор пробелов"]; sm -> llm [label="extraction,\nexplanation (JSON)"];
}