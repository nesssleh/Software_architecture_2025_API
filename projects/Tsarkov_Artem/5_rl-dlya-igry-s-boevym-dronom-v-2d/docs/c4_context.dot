digraph G {
graph [rankdir=LR, fontname="DejaVu Sans", fontsize=11, bgcolor=white, pad=0.3, nodesep=0.45, ranksep=0.7, labelloc=t];
node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=10, color="#2b4a7a", fillcolor="#dce7f7", margin="0.15,0.08"];
edge [fontname="DejaVu Sans", fontsize=8, color="#555555"];
label="C4 Level 1 — System Context: Drone Combat RL";
ml [shape=box, style="rounded,filled", fillcolor="#08427b", fontcolor=white, label="ML-инженер\n[Person]"];
op [shape=box, style="rounded,filled", fillcolor="#08427b", fontcolor=white, label="Оператор симуляции"];
sys [fillcolor="#438dd5", fontcolor=white, label="Drone Combat RL\n[Software system]\nсимулятор + обучение + inference"];
mlf [fillcolor="#e8e8e8", color="#888888", label="MLflow\ntracking"];
ml -> sys [label="обучение, эксперименты"]; op -> sys [label="запуск эпизодов,\nстатистика"]; sys -> mlf;
}